APP_ENV=development
APP_BASE_URL=http://localhost:8080

# Initial admin: on startup, if no active admin exists, this user is created
# or promoted to admin. Ignored when an admin already exists.
INITIAL_ADMIN_EMAIL=admin@example.com

# Local development uses SQLite by default (./mealplanner.sqlite).
# Use one of these to override:
# DB_DRIVER=sqlite
# SQLITE_PATH=:memory:
# DATABASE_URL=sqlite::memory:
# DATABASE_URL=postgres://mealplanner:mealplanner@localhost:5432/mealplanner
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAGIC_LINK_TTL_SECONDS=900

# Optional providers. Without SMTP2GO_API_KEY, links are logged to the console.
SMTP2GO_API_KEY=
EMAIL_FROM=MealPlanner <login@example.com>

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini

SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_BUCKET=mealplanner-images
SPACES_REGION=fra1
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.example.mealplanner
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
